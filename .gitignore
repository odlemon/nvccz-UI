*.log
_build-*-log.txt
/analytics-spend.png
/dashboard-srd.png
/invoice-processing.png
/requisition-assist.png
/arcus-*-costs*.xlsx
/arcus-cost-analysis*.xlsx
/test-content.js
/test-dashboard.js
/test-profile.js
/test-role.js
/test-title.js

# Credential-bearing local files (never commit)
deploy/nvccz/CREDENTIALS*.local.md
design-refs/vps-access-and-ssl-reference.md

# Large local SRD binaries / client packages not yet integrated
design-refs/fpa-srds/*.pdf
design-refs/portfolio-v25/

# Python cache + tmp/diag/log scratch under scripts/
scripts/__pycache__/
scripts/_tmp*/
scripts/_tmp-*
scripts/*-log*.txt
scripts/_*-out.txt
scripts/_*-log*.txt
scripts/_inspect-out.txt
scripts/_verify-out.txt
scripts/_perf-check-out.txt
scripts/_uat/_tmp-*
scripts/_uat/fixtures/test-invoice.pdf

# One-off deploy/helper scripts with hardcoded host passwords (stay on disk, never commit)
scripts/deploy-nvccz-api-singapore.py
scripts/deploy-nvccz-docker-vps.py
