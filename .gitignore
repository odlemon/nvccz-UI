# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules

# next.js
/.next/
/.next-*/
/out/

# production
/build

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
deploy/nvccz/CREDENTIALS.local.md
deploy/nvccz/CREDENTIALS.nts-prod.local.md

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local product docs / SRD (not committed)
/docs/

# claude code worktrees
.claude/worktrees/
# Local-only secrets (never commit) - added 2026-09-07 after credential rotation
.secrets/

# Credential-bearing files that must never be committed (added 2026-09-07).
# The scratch ops helpers under scripts/_*.py accumulated hard-coded server and
# database passwords over time; 29 of them still hold live values. _ssh_creds.py
# is the deliberate exception: it holds no secret, it reads one from
# .secrets/ssh.env or $ARCUS_SSH_PASSWORD.
design-refs/credentials-and-database-access.md
scripts/_*.py
!scripts/_ssh_creds.py
.patch-performance-runtime.lock
.perf-dumps/
.acc-dumps/
.lp-dumps/
.lp-done/
.lp-final/
.lp-verify/
.lp-check/
.lp-shots/

# Fundraising verification output (scripts/fundraising-*.mjs)
.fr-dump/
.fr-trace/
.fr-e2e/

# Agent / local tooling scratch
.agents/
.kilo/

# Portal / module UAT dumps, traces, tokens, AI-capture artifacts
.lp-uat/
.lp-trace/
.payroll-dumps/
.payroll-trace/
.procurement-ai-capture/
.procurement-ai-capture-dev/
.procurement-crossmodule/

