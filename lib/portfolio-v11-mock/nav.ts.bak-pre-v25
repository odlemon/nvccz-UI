/** Portfolio V11 page id → Next path */
export const PV11_PAGE_TO_PATH: Record<string, string> = {
  dashboard: '/portfolio',
  deals: '/portfolio/deals',
  funds: '/portfolio/funds',
  'capital-calls': '/portfolio/capital-calls',
  companies: '/portfolio/companies',
  'cash-accounts': '/portfolio/cash-accounts',
  'cash-overview': '/portfolio/cash-overview',
  'cash-ledger': '/portfolio/cash-ledger',
  'cash-reservations': '/portfolio/cash-reservations',
  'statement-imports': '/portfolio/statement-imports',
  reconciliations: '/portfolio/reconciliations',
  exceptions: '/portfolio/exceptions',
  'period-close': '/portfolio/period-close',
  reporting: '/portfolio/reporting',
  'fund-performance': '/portfolio/fund-performance',
  lps: '/portfolio/lps',
  'documents-vault': '/portfolio/documents',
  'reports-vault': '/portfolio/reports-vault',
  'e-signatures': '/portfolio/e-signatures',
  'mailer-lists': '/portfolio/mailer-lists',
  settings: '/portfolio/settings',
  // details
  'deal-detail': '/portfolio/deals/detail',
  'company-detail': '/portfolio/companies/detail',
  'fund-detail': '/portfolio/funds/detail',
  'lp-detail': '/portfolio/lps/detail',
  'capital-call-detail': '/portfolio/capital-calls/detail',
  'reconciliation-workspace': '/portfolio/reconciliations/workspace',
  'report-builder': '/portfolio/reports-vault/builder',
  'applicant-portal': '/portfolio/applicant-portal',
  'analytics-detail': '/portfolio/analytics',
}

export const PV11_PATH_TO_PAGE: Record<string, string> = Object.fromEntries(
  Object.entries(PV11_PAGE_TO_PATH).map(([page, p]) => [p, page])
)

export function pathToPv11Page(pathname: string): string {
  const clean = String(pathname || '').replace(/\/+$/, '') || '/portfolio'
  if (clean in PV11_PATH_TO_PAGE) return PV11_PATH_TO_PAGE[clean]
  if (clean.startsWith('/portfolio/deals/detail')) return 'deal-detail'
  if (clean.startsWith('/portfolio/deals')) return 'deals'
  if (clean.startsWith('/portfolio/funds/detail')) return 'fund-detail'
  if (clean.startsWith('/portfolio/funds')) return 'funds'
  if (clean.startsWith('/portfolio/companies/detail')) return 'company-detail'
  if (clean.startsWith('/portfolio/companies')) return 'companies'
  if (clean.startsWith('/portfolio/lps/detail')) return 'lp-detail'
  if (clean.startsWith('/portfolio/lps')) return 'lps'
  if (clean.startsWith('/portfolio/capital-calls/detail')) return 'capital-call-detail'
  if (clean.startsWith('/portfolio/capital-calls')) return 'capital-calls'
  if (clean.startsWith('/portfolio/reconciliations/workspace')) return 'reconciliation-workspace'
  if (clean.startsWith('/portfolio/reconciliations')) return 'reconciliations'
  if (clean.startsWith('/portfolio/reports-vault/builder')) return 'report-builder'
  if (clean.startsWith('/portfolio/reports-vault')) return 'reports-vault'
  return 'dashboard'
}

