{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "staff-portal",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3001
    },
    {
      "name": "staff-portal-review",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "next",
        "dev",
        "-p",
        "3120"
      ],
      "port": 3120,
      "env": {
        "NEXT_PUBLIC_PORTAL": "staff",
        "NEXT_DIST_DIR": ".next-staff-review",
        "NEXT_PUBLIC_LP_PORTAL_URL": "http://localhost:3110",
        "NEXT_PUBLIC_INVESTEE_PORTAL_URL": "http://localhost:3120",
        "NEXT_PUBLIC_APPLY_PORTAL_URL": "http://localhost:3130",
        "NEXT_PUBLIC_VENDOR_PORTAL_URL": "http://localhost:3140",
        "NEXT_PUBLIC_EVENTS_PORTAL_URL": "http://localhost:3150"
      }
    }
  ]
}