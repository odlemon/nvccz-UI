{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "staff-portal",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3001,
      "autoPort": false
    },
    {
      "name": "staff-portal-attached",
      "port": 3001,
      "url": "http://localhost:3001"
    },
    {
      "name": "staff-portal-review",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "next",
        "dev",
        "-p",
        "3120"
      ],
      "port": 3120,
      "env": {
        "NEXT_PUBLIC_PORTAL": "staff",
        "NEXT_DIST_DIR": ".next-staff-review",
        "NEXT_PUBLIC_LP_PORTAL_URL": "http://localhost:3110",
        "NEXT_PUBLIC_INVESTEE_PORTAL_URL": "http://localhost:3120",
        "NEXT_PUBLIC_APPLY_PORTAL_URL": "http://localhost:3130",
        "NEXT_PUBLIC_VENDOR_PORTAL_URL": "http://localhost:3140",
        "NEXT_PUBLIC_EVENTS_PORTAL_URL": "http://localhost:3150"
      }
    },
    {
      "name": "investee-portal-review",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "next",
        "dev",
        "-p",
        "3120"
      ],
      "port": 3120,
      "env": {
        "NEXT_PUBLIC_PORTAL": "investee",
        "NEXT_DIST_DIR": ".next-investee-review"
      }
    },
    {
      "name": "lp-portal-review",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "next",
        "dev",
        "-p",
        "3130"
      ],
      "port": 3130,
      "env": {
        "NEXT_PUBLIC_PORTAL": "lp",
        "NEXT_DIST_DIR": ".next-lp-review"
      }
    },
    {
      "name": "vendor-portal-uat",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "node_modules/next/dist/bin/next",
        "dev",
        "-p",
        "3001"
      ],
      "port": 3001,
      "env": {
        "NEXT_PUBLIC_PORTAL": "vendor",
        "NEXT_DIST_DIR": ".next-vendor-uat",
        "NEXT_PUBLIC_AUTH_TOKEN_KEY": "token_vendor",
        "NEXT_PUBLIC_AUTH_PROFILE_KEY": "userProfile_vendor"
      }
    },
    {
      "name": "vendor-portal-preview",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "node_modules/next/dist/bin/next",
        "dev",
        "-p",
        "3140"
      ],
      "port": 3140,
      "env": {
        "NEXT_PUBLIC_PORTAL": "vendor",
        "NEXT_DIST_DIR": ".next-vendor-preview",
        "NEXT_PUBLIC_AUTH_TOKEN_KEY": "token_vendor_preview",
        "NEXT_PUBLIC_AUTH_PROFILE_KEY": "userProfile_vendor_preview"
      }
    },
    {
      "name": "staff-portal-uat",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "node_modules/next/dist/bin/next",
        "dev",
        "-p",
        "3001"
      ],
      "port": 3001,
      "env": {
        "NEXT_PUBLIC_PORTAL": "staff",
        "NEXT_DIST_DIR": ".next-staff",
        "NEXT_PUBLIC_AUTH_TOKEN_KEY": "token_staff",
        "NEXT_PUBLIC_AUTH_PROFILE_KEY": "userProfile_staff"
      }
    },
    {
      "name": "procurement-preview",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "node_modules/next/dist/bin/next",
        "dev",
        "-p",
        "3199"
      ],
      "port": 3199,
      "env": {
        "NEXT_PUBLIC_PORTAL": "staff",
        "NEXT_DIST_DIR": ".next-procurement-preview",
        "NEXT_PUBLIC_AUTH_TOKEN_KEY": "token_procurement_preview",
        "NEXT_PUBLIC_AUTH_PROFILE_KEY": "userProfile_procurement_preview",
        "NEXT_PUBLIC_API_BASE_URL": "https://dev-api.matanho.com/api"
      }
    },
    {
      "name": "staff-review-3130",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "next",
        "dev",
        "-p",
        "3130"
      ],
      "port": 3130,
      "env": {
        "NEXT_PUBLIC_PORTAL": "staff",
        "NEXT_DIST_DIR": ".next-staff-review",
        "NEXT_PUBLIC_LP_PORTAL_URL": "http://localhost:3110",
        "NEXT_PUBLIC_INVESTEE_PORTAL_URL": "http://localhost:3120",
        "NEXT_PUBLIC_APPLY_PORTAL_URL": "http://localhost:3140"
      }
    }
  ]
}
