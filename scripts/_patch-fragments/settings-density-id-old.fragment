<div class="form-field"><label>Interface density</label><select class="select-control" name="density"><option value="comfortable" ${state.settings.density==='comfortable'?'selected':''}>Comfortable</option><option value="compact" ${state.settings.density==='compact'?'selected':''}>Compact</option><option value="spacious" ${state.settings.density==='spacious'?'selected':''}>Spacious</option></select></div>
