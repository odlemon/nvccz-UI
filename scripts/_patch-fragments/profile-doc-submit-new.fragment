    if(e.target.id==='profileDocumentForm'){const f=new FormData(e.target),file=f.get('file'),name=f.get('name'),category=f.get('category');if(!file||!file.size){toast('Choose a file to upload.');return}state.profileDocuments.unshift({name,category,size:`${Math.max(1,Math.round(file.size/1024))} KB`,status:'Current',updated:new Date().toLocaleDateString('en-GB',{day:'numeric',month:'short',year:'numeric'}),icon:category==='Profile media'?'profile':'newsletter'});saveState();closePortal();render();toast('Uploading document…');emitIntegrationEvent('profile.document.uploaded',{file,name,category});return}
