      if(action==='help'){modal('Help & Support',`<p style="font-size:12px;color:var(--muted);line-height:1.6">Create a support request and the IT team will pick it up.</p><div class="service-grid" style="margin-top:14px"><button class="service-card card" data-service="support"><div class="task-icon">${icon('support')}</div><div><h4>IT support</h4><p>Device, software or access.</p></div></button></div>`);return}
