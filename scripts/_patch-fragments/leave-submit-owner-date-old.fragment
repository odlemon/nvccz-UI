    if(e.target.id==='leaveRequestForm'){const f=new FormData(e.target),start=new Date(f.get('start')),end=new Date(f.get('end'));let days=Math.max(.5,Math.round((end-start)/86400000)+1);if(f.get('halfDay'))days=.5;if(!Number.isFinite(days)||days<=0){toast('Choose a valid leave period.');return}const hasBalance=Number.isFinite(state.leaveBalance);if(f.get('type')==='Annual leave'&&hasBalance&&days>state.leaveBalance){toast('This request exceeds your available annual leave.');return}if(f.get('type')==='Annual leave'&&hasBalance)state.leaveBalance=Math.max(0,state.leaveBalance-days);const leaveSummary=`${f.get('type')} · ${days} day${days===1?'':'s'}`;state.requests.unshift({id:`LEV-2026-${Math.floor(1100+Math.random()*800)}`,service:leaveSummary,submitted:'31 Jul 2026',owner:'Tawanda Kasere',status:'In progress',next:'Manager approval'});saveState();emitIntegrationEvent('service.request.created',{type:'leave',summary:leaveSummary,amount:null});closePortal();render();toast('Leave request submitted.','success');return}
