    if(!message.title) return `<article class="ai-answer-v16"><div class="ai-answer-head-v16"><div class="ai-orb-v16">${icon('sparkles')}</div><div><strong>Matanho AI</strong><span>${message.sources&&message.sources.length?`Used ${message.sources.length} source${message.sources.length===1?'':'s'}`:'Permission-aware answer'}</span></div></div><p class="ai-answer-summary-v16">${esc(message.text)}</p>${message.sources&&message.sources.length?`<div class="ai-source-chips-v16">${message.sources.map(x=>`<span>${icon('lock')} ${esc(x)}</span>`).join('')}</div>`:''}${(!message.pending&&!message.error)?`<div class="ai-answer-actions-v16"><button class="ghost-btn" data-action="ai-save-latest" data-index="${index}">${icon('bookmark')} Save answer</button></div>`:''}</article>`;
