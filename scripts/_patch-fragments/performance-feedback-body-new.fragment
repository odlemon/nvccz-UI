    const fb=D.performanceFeedback;
    if(!fb||!fb.available) return `<div class="empty-state">${icon('performance')}<h3>No feedback yet</h3><p>${esc((fb&&fb.blockedReason)||'No performance review has been opened for you yet.')}</p></div>`;
    const fields=[['Manager feedback',fb.managerFeedback],['Self feedback',fb.selfFeedback],['Peer feedback',fb.peerFeedback],['Stakeholder feedback',fb.stakeholderFeedback]].filter(([,v])=>v);
    const initialsFor=n=>(n||'').split(' ').map(w=>w[0]||'').join('').slice(0,2).toUpperCase();
    return `<div class="feedback-dashboard"><section class="card feedback-summary-card"><div><span class="eyebrow">${esc(fb.reviewPeriod||'')}</span><h2>${esc(fb.reviewTitle||'Performance review')}</h2>${fb.strengths?`<p>${esc(fb.strengths)}</p>`:''}</div>${fb.overallScore!=null||fb.rating?`<div class="feedback-score-ring"><strong>${fb.overallScore!=null?Math.round(fb.overallScore):'—'}</strong><span>${fb.rating?esc(fb.rating):'Score'}</span><small>${esc(fb.status||'')}</small></div>`:''}</section>${fields.length?`<section class="card card-pad"><div class="card-title"><h3>Feedback by reviewer</h3></div>${fields.map(([label,text])=>`<div class="detail-section"><h4>${label}</h4><p style="font-size:11px;color:var(--muted);line-height:1.65">${esc(text)}</p></div>`).join('')}</section>`:''}${fb.entries.length?`<section class="card card-pad"><div class="card-title"><div><span class="eyebrow">Comments</span><h3>Reviewer comments</h3></div></div>${fb.entries.map(e=>`<article class="quote-feedback">${avatar({name:e.providerName,initials:initialsFor(e.providerName)})}<div><div><strong>${esc(e.providerName)}</strong><span>${esc(e.providerType||'')}</span></div><blockquote>${esc(e.content)}</blockquote><small>${esc(e.submittedAt||'')}</small></div></article>`).join('')}</section>`:''}${fb.areasForImprovement?`<section class="card card-pad"><div class="card-title"><h3>Areas for improvement</h3></div><p style="font-size:11px;color:var(--muted);line-height:1.65">${esc(fb.areasForImprovement)}</p></section>`:''}</div>`;
