function personDetail(p){
    const i=D.people.findIndex(x=>x.id===p.id);
    const manager=D.people.find(x=>x.name===p.manager);
    return `<div class="profile-hero-v4"><div class="profile-photo-large">${avatar(p)}</div><div class="profile-identity"><span class="verified-pill">${icon('check')} Verified profile</span><h2>${p.name}</h2><p>${p.role}<br>${p.team} · ${p.location}</p><div class="status-text"><i class="status-dot ${p.statusType}"></i>${p.status}</div></div></div><div class="profile-actions"><button class="primary-btn" data-action="message-person">${icon('message')} Message</button><button class="secondary-btn" data-action="schedule-person">${icon('calendar')} Schedule time</button><button class="icon-only more-actions-btn" data-action="profile-more" aria-label="More profile actions">${icon('more')}</button></div><div class="person-quick-metrics"><div><span>Performance</span><strong>${p.score}</strong></div><div><span>Tenure</span><strong>${['2y 4m','4y 1m','3y 7m','5y 2m','2y 9m','6y 3m','1y 8m','3y 2m'][i]}</strong></div><div><span>Projects</span><strong>${p.projects.length}</strong></div></div><div class="detail-section"><h4>Reports to</h4><div class="detail-line">${manager?avatar(manager):avatar(p.manager.split(' ').map(x=>x[0]).join(''),'sand')}<div><strong>${p.manager}</strong><div style="font-size:9px;color:var(--muted)">Manager</div></div><button class="link-btn" style="margin-left:auto">View org</button></div></div><div class="detail-section"><h4>Current projects</h4>${p.projects.map((x,j)=>`<div class="project-status"><div><strong>${x}</strong><span>${['Financial modelling & diligence','Portfolio analysis & reporting','Research & policy development'][j]||'Cross-functional delivery'}</span></div><span class="status-pill ${j<2?'low':'medium'}">${j<2?'On track':'In progress'}</span></div>`).join('')}</div><div class="detail-section"><h4>Skills & expertise</h4><div class="skill-cloud">${p.expertise.map(x=>`<span>${x}</span>`).join('')}</div></div><div class="detail-section"><h4>Contact</h4><div class="detail-line">${icon('newsletter')}<span>${p.email}</span></div><div class="detail-line">${icon('message')}<span>${p.phone}</span></div><div class="detail-line">${icon('location')}<span>${p.location}, Zimbabwe</span></div></div><div class="collaboration-card"><div><span class="eyebrow">Collaboration</span><strong>Start something together</strong><p>Message, schedule time or invite ${p.name.split(' ')[0]} to a project.</p></div><button class="secondary-btn" data-action="message-person">${icon('message')} Send message</button></div>`;
  }
  