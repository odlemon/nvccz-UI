    return `<div class="apps-v9">${pageHead('Apps','Your gateway to the tools and workspaces you have access to.',`<button class="secondary-btn" data-action="view-access-requests">${icon('clock')} My requests</button><button class="primary-btn" data-action="request-app-access">${icon('plus')} Request access</button>`)}<section class="card card-pad"><div class="card-title"><div><h3>Connected apps</h3><p>Modules you have access to across Matanho.</p></div></div><div class="app-browser-grid-v9">${state.apps.length?state.apps.map((a,i)=>`<article class="card app-card app-card-v9 card-hover" data-launch-app="${a.id}">${avatar({name:a.name,initials:(a.name||'').split(' ').map(w=>w[0]||'').join('').slice(0,2).toUpperCase()},colorByIndex(i))}<div><h4>${a.name}</h4><p>${a.description||''}</p></div>${icon('arrow')}</article>`).join(''):`<div class="work-empty-state">${icon('apps')}<strong>No connected apps yet.</strong><span>Your role doesn't have access to any other Matanho modules.</span></div>`}</div></section></div>`;
