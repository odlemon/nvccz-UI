    if(e.target.id==='settingsForm'){const f=new FormData(e.target);state.settings={...state.settings,language:f.get('language'),timezone:f.get('timezone'),density:f.get('density'),profileVisibility:f.get('profileVisibility'),saturation:Number(f.get('saturation')||118),glass:f.has('glass'),motion:f.has('motion'),autoHero:f.has('autoHero'),usageAnalytics:f.has('usageAnalytics'),calendarAlerts:f.has('calendarAlerts'),newsDigest:f.has('newsDigest'),forumMentions:f.has('forumMentions'),performanceReminders:f.has('performanceReminders')};saveState();emitIntegrationEvent('preferences.settings.updated',{settings:state.settings});closePortal();render();toast('Preferences saved across your workspace.','success');return}
