    const documents=`<div class="profile-tab-content-v8"><section class="card card-pad"><div class="profile-card-head"><div><h3>Your documents</h3><p>Certifications, education records and other profile files.</p></div><button class="primary-btn" data-action="upload-profile-document">${icon('plus')} Add document</button></div>${state.profileDocuments.length?`<div style="margin-top:10px">${state.profileDocuments.map((d,i)=>`<button data-profile-document="${i}" style="width:100%;text-align:left;border:0;border-bottom:1px solid var(--line);background:none;cursor:pointer;display:flex;align-items:center;justify-content:space-between;gap:14px;padding:12px 4px"><span style="display:flex;align-items:center;gap:9px;min-width:0"><span style="flex:0 0 auto">${icon(d.icon||'newsletter')}</span><span style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap"><strong style="display:block;font-size:11px">${esc(d.name)}</strong><span style="font-size:9.5px;color:var(--muted)">${esc(d.category)}${d.size?` · ${esc(d.size)}`:''}</span></span></span><span style="flex:0 0 auto;font-size:9.5px;color:var(--muted)">Updated ${esc(d.updated||'')}</span></button>`).join('')}</div>`:`<div class="empty-state-row">No documents added yet.</div>`}</section></div>`;
    const content={Overview:overview,Goals:goals,Documents:documents}[tab]||overview;
