      <div class="ai-answer-actions-v16">${(message.actions||[]).map(a=>`<button class="${a.route||a.mode?'secondary-btn':'primary-btn'}" ${a.route?`data-ai-open-route="${a.route}"`:a.mode?`data-ai-mode="${a.mode}"`:`data-action="${a.action}"`}>${icon(a.icon||'arrow')} ${esc(a.label)}</button>`).join('')}<button class="ghost-btn" data-action="ai-save-latest" data-index="${index}">${icon('bookmark')} Save answer</button></div>
