    if(e.target.id==='appAccessForm'){const f=new FormData(e.target),id=f.get('appId'),reason=f.get('reason');if(!state.appAccessRequests.some(r=>r.appId===id&&r.status==='Pending'))state.appAccessRequests.unshift({appId:id,status:'Pending',submitted:new Date().toLocaleDateString('en-GB',{day:'numeric',month:'short',year:'numeric'}),reason});saveState();closePortal();render();toast('App access request submitted.','success');emitIntegrationEvent('app.access.requested',{appId:id,reason});return}
