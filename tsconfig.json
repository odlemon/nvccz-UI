{
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "target": "ES6",
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next-staff/types/**/*.ts",
    ".next-lp/types/**/*.ts",
    ".next-investee/types/**/*.ts",
    ".next-apply/types/**/*.ts",
    ".next-staff-review/types/**/*.ts",
    ".next-build-verify/types/**/*.ts",
    ".next-staff-uat/types/**/*.ts",
    ".next-lp-uat/types/**/*.ts",
    ".next-procurement-preview/types/**/*.ts",
    ".next-vendor-preview/types/**/*.ts",
    ".next-vendor-review/types/**/*.ts",
    ".next-staff-home-page/types/**/*.ts",
    ".next-staff-staff3011/types/**/*.ts",
    ".next-staff-expenses-detail-fix/types/**/*.ts",
    ".next-staff-approval-verify/types/**/*.ts",
    ".next-staff-visible-verify/types/**/*.ts",
    ".next-staff-.next-staff-board/types/**/*.ts",
    ".next-staff-fix/types/**/*.ts",
    ".next-events/types/**/*.ts",
    ".next-events-events-local-3019/types/**/*.ts",
    ".next-staff-events-local-3019/types/**/*.ts",
    ".next-vendor/types/**/*.ts",
    ".next-staff-payroll-isolated-20261028/types/**/*.ts",
    ".next-staff-payroll-settings-isolated/types/**/*.ts",
    ".next-staff-performance-approval-hide/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
